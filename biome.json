{
  "$schema": "https://biomejs.dev/schemas/1.9.0/schema.json",
  "files": {
    "ignore": [
      "node_modules",
      "dist",
      "**/node_modules",
      "**/dist",
      "pnpm-lock.yaml",
      "packages/server/migrations",
      "packages/e2e/test-results",
      "packages/e2e/playwright-report",
      "docs/glyph-data.js"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "nursery": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "sonner": "Toasts go through packages/web/src/lib/notify.tsx."
            }
          }
        }
      }
    }
  },
  "overrides": [
    {
      "include": ["packages/web/src/lib/notify.tsx"],
      "linter": {
        "rules": {
          "nursery": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  }
}
