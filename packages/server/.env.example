# Copy to packages/server/.env. Git ignores that file; this one is the template.
# `pnpm dev` loads it. Tests and production do not: tests pass credentials
# explicitly, and production gets real environment variables.

# Social sign-in. In development, leave a pair blank and that provider's button
# disappears. Half a pair refuses to boot. Production requires both pairs.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Everything below already has a working default. See docs/configuration.md.
# PORT=3001
# HOST=127.0.0.1
# DATABASE_URL=data/termitary.db
# BETTER_AUTH_SECRET=
# BETTER_AUTH_URL=http://localhost:3001
# WEB_ORIGIN=http://localhost:5173
# ROOM_SWEEP_INTERVAL_MS=3600000
